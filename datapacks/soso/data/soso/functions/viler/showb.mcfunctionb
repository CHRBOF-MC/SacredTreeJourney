

tellraw @p[tag=flyer] [


{"text":"村民名：","bold":true,"color":"light_purple","clickEvent":{"action":"suggest_command","value":"/data modify entity @e[limit=1,sort=nearest,tag=viler,type=villager] CustomName set value '{\"text\":\"村民A\",\"color\":\"blue\"}'"}},{"selector":"@s"}
,"\n",{"text":"村民Tags","bold":true,"color":"green","clickEvent":{"action":"suggest_command","value":"/data modify entity @e[limit=1,sort=nearest,tag=viler,type=villager] Tags prepend value "}},
{"nbt":"Tags","entity":"@s","bold":false,"color":"white"}
,"\n",{"text":"消除一個Tags","bold":true,"color":"green","clickEvent":{"action":"suggest_command","value":"/execute as @e[limit=1,sort=nearest,tag=viler,type=villager] if data entity @s Tags[1] run data remove entity @s Tags[-1]"}}
