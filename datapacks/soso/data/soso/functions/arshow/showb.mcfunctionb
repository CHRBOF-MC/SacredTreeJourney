,{"text":"｜大範圍鎖定盔甲架","bold":false,"color":"gold","clickEvent":{"action":"run_command","value":"/execute as @e[sort=nearest,tag=arshow,distance=..30] run data modify entity @s DisabledSlots set value 4144959"}}
