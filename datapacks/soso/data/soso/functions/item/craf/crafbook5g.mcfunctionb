{"font":"soso:default","color":"white","text":"\\u0010"},
"\\n\\n",
{"font":"soso:default","color":"white","text":"\\u1016","hoverEvent":{"action":"show_text","contents":{"text":"秘術封紙","color":"gold","bold":"true"}}},
{"font":"soso:default","color":"white","text":"\\u1015","hoverEvent":{"action":"show_text","contents":{"text":"秘術素材","color":"gold","bold":"true"}}},
{"font":"soso:default","color":"white","text":"\\u1016","hoverEvent":{"action":"show_text","contents":{"text":"秘術封紙","color":"gold","bold":"true"}}},
"\\n\\n",
{"font":"soso:default","color":"white","text":"\\u0010"},
{"font":"soso:default","color":"white","text":"\\u1016","hoverEvent":{"action":"show_text","contents":{"text":"秘術封紙","color":"gold","bold":"true"}}},
"\\n","\\n",§r,{"font":"minecraft:default","color":"dark_green","bold":true,"text":"============"},"\\n",
{"font":"minecraft:default","color":"light_purple","bold":false,"text":"並將對應素材的秘術給封於紙中。"},
{"font":"minecraft:default","color":"blue","bold":false,"text":"可秘術素材是這些。","hoverEvent":{"action":"show_text","contents":[
{"text":"盤穴洞根：恢復8點生命，冷卻300秒。","color":"white","bold":"true"},"\\n"
,{"text":"命脈肉排：增加5點魔攻30秒，冷卻200秒。","color":"white","bold":"true"},"\\n"
,{"text":"氓騰山果：詠唱速度上升10% 30秒，冷卻200秒。","color":"white","bold":"true"},"\\n"
,{"text":"魔泥汙骨：魔力消費減少5% 30秒，冷卻100秒。","color":"white","bold":"true"},"\\n"
,{"text":"銀狼毛皮：移動速度上升10% 30秒，冷卻100秒。","color":"white","bold":"true"},"\\n"
,{"text":"秘銀錠：盔甲上升2點30秒，冷卻120秒。","color":"white","bold":"true"},"\\n"
,{"text":"曼陀羅草：發射40傷害單體攻擊魔彈，冷卻150秒。","color":"white","bold":"true"},"\\n"
,{"text":"惡惑核心：發射40傷害範圍攻擊攻擊魔彈，冷卻300秒。","color":"white","bold":"true"},"\\n"
]}},"\\n",
""]'
